# VibeStartup's .env cascade (the CommandAGI pattern: AGENTS.md § secrets, docs/deploy.md § secrets). Every value lives
# in a gitignored file at this repository's root; this file names them. The site itself holds no secret: it is static
# files and app.mjs, and talks to CommandAGI's API with the founder's own token.
#
#   .env           what scripts here read for every stack
#   .env.accounts  account logins and facts no code reads (ids, test tokens, owner notes); nothing pushes it
#
# Secrets that CommandAGI's code reads for VibeStartup (the Meta app, Turnstile hosts, …) live in CommandAGI's cascade
# as service-account lines (SVC__<SERVICE>__<ACCOUNT>__<FIELD>, e.g. SVC__META__VIBESTARTUP_ADS__APP_SECRET in
# .env.api), never here: one value, one place.

# .env
CLOUDFLARE_ACCOUNT_ID=          # Hello@vibestartup.pro's account: the vibestartup.pro zone, the edge worker
CLOUDFLARE_ZONE_ID=             # vibestartup.pro
VS_ADMIN_KEY=                   # a staff key of a CommandAGI stack, for test/hire.mjs (grants credits on dev)

# .env.accounts
META_APP_ID_ADS=                # "VibeStartup Ads" (Marketing API), business portfolio commandagi
META_APP_ID_LOGIN=              # "VibeStartup" (Facebook Login, 2025), business portfolio VibeStartup
META_BUSINESS_ID_COMMANDAGI=
META_BUSINESS_ID_VIBESTARTUP=
META_TEST_AD_ACCOUNT=
META_VIBESTARTUP_ADS_TEST_USER_TOKEN=   # short-lived Graph API Explorer token, for the use-case tests
EDGE_WORKER=                    # vibestartup-subdomains
EDGE_ROUTE_ID=                  # *.vibestartup.pro/*
